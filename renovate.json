{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "rangeStrategy": "update-lockfile",
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Never touch the supported Python floor; bump it by hand when dropping a version",
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Pin dev dependencies exactly, like the Home Assistant libs",
      "matchDepTypes": ["dependency-groups"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Automerge non-major dev updates",
      "matchDepTypes": ["dependency-groups", "tools", "action", "uses-with"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDepTypes": ["project.dependencies", "project.optional-dependencies"],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepTypes": ["dependency-groups", "tools"],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchDepTypes": ["action", "uses-with"],
      "semanticCommitType": "ci"
    }
  ]
}
